*.bag
*.bag.active

# Catkin / Colcon
.catkin_workspace
.catkin_tools/

# Third-party model zoos (cloned, not vendored) — see simulation/mujoco/week1_reach.py
third_party/

# Pretrained weights (fetched, not vendored) — same reasoning as third_party/.
# yolo11n.pt is a stock 5.6 MB Ultralytics COCO checkpoint that nothing in this
# repo trains or modifies; see simulation/mujoco/detect.py for where it is read.
#   ./.venv/bin/python -c "from ultralytics import YOLO; YOLO('yolo11n.pt')"
#   mv yolo11n.pt models/weights/
models/weights/*.pt

# Weekly demo captures
*.mp4

# Pick logs from week4_run.py / week4_place.py --log. One JSONL row per attempt,
# so these grow without bound and are re-derivable by re-running the campaign.
# The *numbers* read off them belong in the README and the instructions doc, not
# in the repo as raw rows.
runs/

# Generated by simulation/mujoco/fr5.py (MuJoCo-compatible URDF rewrite)
_fr5_mujoco.urdf
fr5_home.png
fr5_gripper.png

# Generated by simulation/mujoco/greenhouse.py (camera stills)
greenhouse_*.png

# MuJoCo runtime log
MUJOCO_LOG.TXT
